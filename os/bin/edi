#!/bin/bash
# edi — control de EDI desde la terminal, Niri o Waybar.
set -euo pipefail
case "${1:-status}" in
  status)
    curl -s --max-time 1 127.0.0.1:7077/state | jq -r '"\(.name) · edad \(.age_bio_s|floor)s · energía \((.energy*100)|floor)% · sueño \((.sleep_pressure*100)|floor)% · \(if .asleep then "durmiendo" else "despierta" end) · spikes \(.spikes_last_tick)"' 2>/dev/null \
      || echo "EDI no responde (systemctl --user status edid)"
    ;;
  waybar)
    s=$(curl -s --max-time 1 127.0.0.1:7077/state || true)
    if [ -z "$s" ]; then echo '{"text":"EDI ·","class":"off"}'; exit 0; fi
    echo "$s" | jq -c '{text: (if .asleep then "EDI 󰒲" else "EDI 󰋑" end), tooltip: "energía \((.energy*100)|floor)% · spikes \(.spikes_last_tick)", class: (if .asleep then "asleep" else "awake" end)}'
    ;;
  toggle)
    if systemctl --user is-active -q edid; then systemctl --user stop edid; else systemctl --user start edid; fi
    ;;
  say)   shift; curl -s --max-time 15 -X POST --data "$*" 127.0.0.1:7077/say | jq -r '(if .edi then "EDI: \(.edi)   [\(.kind)]" else "EDI: (lo toma como tu aprobación)" end), (if .known then "  recuerda «\(.query)»: " + ([.recalled[:5][].label] | join(" · ")) else empty end)' ;;
  +|-)   curl -s -X POST --data "$1" 127.0.0.1:7077/reward >/dev/null && echo "${1/+/👍}${1/-/👎} a su última respuesta → dopamina" | tr -d '+-' ;;
  teach) shift; curl -s -X POST --data "$*" 127.0.0.1:7077/teach >/dev/null && echo "✏️ a eso se responde: «$*»" ;;
  chat)  curl -s 127.0.0.1:7077/chat | jq -r --argjson n "${2:-12}" '.turns[-$n:][] | (if .who == "edi" then "  EDI › \(.text)   [\(.kind)\(if .reward > 0 then " 👍" elif .reward < 0 then " 👎" else "" end)]" else "   tú › \(.text)" + (if .kind != "frase" then "   [\(.kind)]" else "" end) end)' ;;
  learn) curl -s 127.0.0.1:7077/learn | jq . ;;
  reward) curl -s -X POST --data "${2:-+}" 127.0.0.1:7077/reward >/dev/null && echo "refuerzo ${2:-+} → dopamina" ;;
  sleep) curl -s -X POST 127.0.0.1:7077/sleep >/dev/null && echo "EDI se va a dormir" ;;
  brain) exec edi-shell ;;
  face)  curl -s --max-time 1 127.0.0.1:7077/face | jq -r '"[\(.name)] \(.line)"' ;;
  widget) exec edi-shell --widget ;;
  log)   tail -n "${2:-20}" "$HOME/.local/state/edi/events.jsonl" ;;
  *)     echo "uso: edi [status|say TEXTO|+|-|teach TEXTO|chat N|reward +|-|learn|face|sleep|brain|widget|waybar|toggle|log N]"; exit 1 ;;
esac
